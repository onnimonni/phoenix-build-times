From 6b1f22712be9823923f6eea827a92211ea84fa9a Mon Sep 17 00:00:00 2001
From: Onni Hakala <onni@fyff.ee>
Date: Fri, 30 Oct 2026 18:31:44 +0200
Subject: [PATCH] compiler: Don't crash on number ranges beyond the float range

beam_types:norm_number/1 converts the range bounds and their neighbours
to floats. Integers larger than the float range (e.g. a guard comparing
against 10^2000, as in the decimal library) made float/1 raise badarg,
crashing beam_validator with an internal error. Such integers have no
float neighbours to normalize to, so keep them as they are.

Introduced in 6fc2465974 (Fix `argument_widened` assertion).
---
 lib/compiler/src/beam_types.erl | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/lib/compiler/src/beam_types.erl b/lib/compiler/src/beam_types.erl
index 590d7751c05b..f5840a95f69e 100644
--- a/lib/compiler/src/beam_types.erl
+++ b/lib/compiler/src/beam_types.erl
@@ -1093,11 +1093,15 @@ norm_number_range(any) ->
     #t_number{}.
 
 norm_number(N) when is_number(N) ->
-    {F0,F1,F2} = {float(N-1), float(N), float(N+1)},
-    if
-        F0 =:= F1; F1 =:= F2 ->
+    try {float(N-1), float(N), float(N+1)} of
+        {F0,F1,F2} when F0 =:= F1; F1 =:= F2 ->
             floor(F1);
-        true ->
+        {_,_,_} ->
+            N
+    catch
+        error:badarg ->
+            %% Integers beyond the float range have no float neighbours
+            %% to normalize to.
             N
     end;
 norm_number(Other) ->
