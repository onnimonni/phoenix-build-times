+  defp put_type_checks(state, type_checks) do
+    Enum.reduce(type_checks, state, fn {module, types}, state ->
+      state
+      |> update_type_checks(:modules, module, types)
+      |> update_type_checks(:pending_modules, module, types)
+    end)
+  end
+
+  defp update_type_checks(state, key, module, types) do
+    case state do
+      %{^key => %{^module => entry} = modules} ->
+        %{state | key => %{modules | module => module(entry, types: types)}}
+
+      %{} ->
+        state
+    end
+  end
