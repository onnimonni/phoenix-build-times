+      """)
+
+      File.write!("lib/b.ex", """
+      defmodule B do
+        def run, do: A.path() <> "!"
+      end
+      """)
+
+      compile = fn args ->
+        capture_io(:stderr, fn ->
+          Mix.Tasks.Compile.Elixir.run(["--profile", "time" | args])
+        end)
+      end
+
+      # Only the warnings of B, without profile information
+      warnings = fn output ->
+        output |> String.split("\n") |> Enum.reject(&(&1 =~ "[profile]")) |> Enum.join("\n")
+      end
+
+      output = compile.([])
+      assert output =~ "incompatible types"
+      assert output =~ "Type checked B"
+      checked = warnings.(output)
+
+      # Same signatures, so B is not type checked, but its warnings are the same
+      File.write!("lib/a.ex", """
+      defmodule A do
+        @doc "The path"
+        def path, do: :a
+      end
+      """)
+
+      ensure_touched("lib/a.ex", "_build/dev/lib/sample/.mix/compile.elixir")
+      output = compile.(["--no-all-warnings"])
+      refute output =~ "Type checked B"
+      assert warnings.(output) == checked
+
